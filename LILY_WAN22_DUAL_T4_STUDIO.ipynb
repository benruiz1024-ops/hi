{"cells":[{"cell_type":"markdown","metadata":{},"source":["# ✦ LILY WAN 2.2 — CLEAN v9\n","\n","Disk-safe rebuild. Clears leftovers from failed attempts before setup and never writes a temporary requirements file.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"trusted":true},"outputs":[],"source":["import os, sys, subprocess, shutil, time\n","from pathlib import Path\n","\n","ROOT=Path('/kaggle/working')\n","print('✦ Lily Wan 2.2 Studio — CLEAN v9 / DISK RECOVERY')\n","\n","# Failed earlier runs filled Kaggle storage. Recover it BEFORE writing anything.\n","for p in [ROOT/'lily_pkgs', ROOT/'lily_comfy_env', ROOT/'Practical-RIFE', ROOT/'rife_extract', ROOT/'rife425lite']:\n","    if p.exists():\n","        print('Removing old:', p)\n","        shutil.rmtree(p, ignore_errors=True) if p.is_dir() else p.unlink(missing_ok=True)\n","for p in ROOT.glob('*.part'):\n","    p.unlink(missing_ok=True)\n","subprocess.run([sys.executable,'-m','pip','cache','purge'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n","usage=shutil.disk_usage(ROOT)\n","print(f'✓ Free disk after cleanup: {usage.free/1024**3:.1f} GB')\n","if usage.free < 14*1024**3:\n","    raise RuntimeError(f'Only {usage.free/1024**3:.1f} GB free. Stop this Kaggle session and start a NEW session once; old failed downloads are consuming the session disk.')\n","\n","# Run the clean v8 body from here, but patch its one disk-unsafe requirements-file step in memory.\n","import json, urllib.request\n","url='https://raw.githubusercontent.com/benruiz1024-ops/hi/f65a8bf73e8a678fc66d1772e7dd126493aaec45/LILY_WAN22_DUAL_T4_STUDIO.ipynb'\n","with urllib.request.urlopen(url, timeout=30) as r:\n","    nb=json.loads(r.read().decode())\n","code=''.join(nb['cells'][1]['source'])\n","start=code.index("req = COMFY / 'requirements.txt'")\n","end=code.index("# ---------- optional MagCache ----------")\n","replacement='''req = COMFY / 'requirements.txt'\nskip = {'torch','torchvision','torchaudio'}\nlines=[]\nfor line in req.read_text().splitlines():\n    s=line.strip()\n    if not s or s.startswith('#'):\n        continue\n    base=s.split(';',1)[0].strip().lower()\n    name=base\n    for sep in ('==','>=','<=','~=','>','<'):\n        name=name.split(sep,1)[0].strip()\n    if name not in skip:\n        lines.append(line)\nprint('Installing ComfyUI top-level packages without CUDA/Torch recursion...')\nfor line in lines:\n    subprocess.run([sys.executable,'-m','pip','install','-q','--no-deps','--disable-pip-version-check',line], check=True)\nprint('✓ ComfyUI requirements ready')\n\n'''
","code=code[:start]+replacement+code[end:]\n","code=code.replace("print('✦ Lily Wan 2.2 Studio — CLEAN v8')", "print('✓ Entering clean generator setup')")\n","compile(code,'LILY_WAN22_V9_BODY','exec')\n","print('✓ v9 compile preflight passed')\n","exec(compile(code,'LILY_WAN22_V9_BODY','exec'),globals(),globals())\n"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12"},"kaggle":{"accelerator":"gpu","isGpuEnabled":true,"isInternetEnabled":true,"language":"python","sourceType":"notebook"}},"nbformat":4,"nbformat_minor":5}